{
  "name": "doomledger",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "main": "functions/index.js",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node server/index.js",
